    <bpmn:textAnnotation id="TextAnnotation_0bposws">
      <bpmn:text>If a_sentBack then probability=0.15 else probability=0.02
Where a_activity = number of times the activity was performed in the trace's prefix</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_10d6idm" sourceRef="Flow_13dsyg3" targetRef="TextAnnotation_0bposws" />
    <bpmn:textAnnotation id="TextAnnotation_0upbsu4">
      <bpmn:text>if active_offer &gt;0:  
   if a_sentBack then probability=0.03 else probability=0.55  
Where active_offer = (a_created-a_cancelled)                                and a_activity = number of times the activity was performed in the trace's prefix</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0mcqvd8" sourceRef="Flow_1tc23ii" targetRef="TextAnnotation_0upbsu4" />
    <bpmn:textAnnotation id="TextAnnotation_0ojay7s">
