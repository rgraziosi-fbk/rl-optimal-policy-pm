    <bpmn:association id="Association_19b7xfw" sourceRef="Flow_0pyocht" targetRef="TextAnnotation_0ojay7s" />
    <bpmn:textAnnotation id="TextAnnotation_13m4720">
      <bpmn:text>If active_offer&gt;0 and a_preaccepted&gt;0:
 if a_sentBack&gt;0:
   probability = (0.1, 0.9, 0) 
        else:
  probability = (0.99, 0.01, 0)
else:
 probability = (0.75, 0, 0.25)
Where active_offer = (a_created - a_cancelled),
a_activity = number of times the activity was performed in the trace’s prefix,
probability = (declined, accepted, cancelled)</bpmn:text>
    </bpmn:textAnnotation>
